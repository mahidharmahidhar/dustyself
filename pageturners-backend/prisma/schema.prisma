// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String     @id @default(cuid())
  name      String
  email     String     @unique
  passwordHash String?
  googleId  String?    @unique
  role      String     @default("BUYER")
  phone     String?
  avatar    String?
  bio       String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  // Relations
  books     Book[]     @relation("Seller")
  orders    Order[]    @relation("Buyer")
  reviews   Review[]
  cartItems CartItem[]
  apiKeys   ApiKey[]

  @@map("users")
}

model Book {
  id          String   @id @default(cuid())
  title       String
  author      String
  isbn        String?  @unique
  category    String
  categoryId  String?
  condition   String   @default("GOOD")
  price       Float
  stockQty    Int      @default(1)
  description String
  imageUrl    String?
  sellerId    String
  status      String   @default("ACTIVE")
  rating      Float    @default(0)
  reviewCount Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  seller      User     @relation("Seller", fields: [sellerId], references: [id], onDelete: Cascade)
  orderItems  OrderItem[]
  reviews     Review[]
  cartItems   CartItem[]

  @@map("books")
  @@index([category])
  @@index([sellerId])
}

model Order {
  id              String   @id @default(cuid())
  buyerId         String
  totalAmount     Float
  deliveryAddress String
  city            String?
  state           String?
  zipCode         String?
  latitude        Float?
  longitude       Float?
  paymentStatus   String   @default("PENDING")
  orderStatus     String   @default("PLACED")
  stripeSessionId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  buyer       User      @relation("Buyer", fields: [buyerId], references: [id], onDelete: Cascade)
  items       OrderItem[]

  @@map("orders")
  @@index([buyerId])
}

model OrderItem {
  id            String  @id @default(cuid())
  orderId       String
  bookId        String
  quantity      Int
  priceAtPurchase Float
  createdAt     DateTime @default(now())

  // Relations
  order         Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  book          Book    @relation(fields: [bookId], references: [id], onDelete: Restrict)

  @@map("order_items")
}

model Review {
  id        String   @id @default(cuid())
  bookId    String
  userId    String
  rating    Int
  comment   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("reviews")
  @@unique([bookId, userId])
}

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  description String?
  icon      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("categories")
}

model CartItem {
  id        String   @id @default(cuid())
  userId    String
  bookId    String
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@map("cart_items")
  @@unique([userId, bookId])
}

model ApiKey {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  userId      String
  role        String   @default("USER")
  rateLimit   Int      @default(100)
  usedCount   Int      @default(0)
  isActive    Boolean  @default(true)
  expiresAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  lastUsedAt  DateTime?

  // Relations
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("api_keys")
  @@index([key])
  @@index([userId])
}
