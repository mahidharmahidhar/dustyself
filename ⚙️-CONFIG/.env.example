# Dusty Shelf Backend Environment Configuration
# Copy this file to .env and fill in your values

# ==================== DATABASE ====================
# SQLite (local development)
DATABASE_URL=sqlite:///instance/dustyshelf.db

# PostgreSQL (production - optional)
# DATABASE_URL=postgresql://username:password@localhost:5432/dusty_shelf_db

# ==================== FLASK CONFIGURATION ====================
# Secret key for Flask sessions (change this!)
SECRET_KEY=your-super-secret-key-change-this-in-production-use-random-string

# JWT secret key for token signing (change this!)
JWT_SECRET=your-jwt-secret-key-change-this-in-production-use-random-string

# Server configuration
SERVER_NAME=127.0.0.1:5000

# ==================== GOOGLE OAUTH 2.0 ====================
# Get these from Google Cloud Console: https://console.cloud.google.com/
# See GOOGLE_OAUTH_SETUP.md for complete instructions

# Your Google Client ID (from Google Cloud Console OAuth 2.0 Credentials)
# Format: 123456789-abc...apps.googleusercontent.com
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID_HERE

# Your Google Client Secret (from Google Cloud Console OAuth 2.0 Credentials)
# Format: GOCSPX-abc...
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET_HERE

# Google OAuth Discovery URL (usually this is the default)
GOOGLE_DISCOVERY_URL=https://accounts.google.com/.well-known/openid-configuration

# ==================== CORS CONFIGURATION ====================
# Allowed origins for CORS (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ==================== EMAIL CONFIGURATION (Optional) ====================
# For sending order confirmations and notifications
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password

# ==================== STRIPE CONFIGURATION (Optional) ====================
# For production payment processing
STRIPE_PUBLIC_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...

# ==================== ENVIRONMENT ====================
FLASK_ENV=development
FLASK_DEBUG=True

# Production: set to 'production'
# Development: set to 'development'
