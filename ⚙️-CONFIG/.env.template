# Dusty Shelf E-Commerce Application
# Environment Configuration File
# Copy this to .env and fill in your actual values

# ==================== FLASK BACKEND ====================

# Database Configuration
DATABASE_URL=sqlite:///dusty_shelf.db
# Or use PostgreSQL/MySQL:
# DATABASE_URL=postgresql://user:password@localhost/dusty_shelf
# DATABASE_URL=mysql+pymysql://user:password@localhost/dusty_shelf

# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=your-super-secret-key-change-in-production-2024
JWT_SECRET=your-jwt-secret-key-change-in-production-2024

# ==================== GOOGLE OAUTH ====================

# Google OAuth Configuration (from Google Cloud Console)
# Create a project at https://console.cloud.google.com/
# Create OAuth 2.0 credentials (Web Application type)
# Add authorized redirect URIs:
#   - http://127.0.0.1:5000/login/google/authorized
#   - http://localhost:5000/login/google/authorized
#   - https://yourdomain.com/login/google/authorized (for production)

GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_DISCOVERY_URL=https://accounts.google.com/.well-known/openid-configuration

# ==================== BOOK FETCHING ====================

# Google Books API Key (https://developers.google.com/books/docs/v1/getting_started)
GOOGLE_BOOKS_API_KEY=your-google-books-api-key

# Open Library API (no key required, public API)
# Already configured in the script

# ==================== SERVER CONFIGURATION ====================

# Server Settings
SERVER_NAME=127.0.0.1:5000
# For production, set to your domain:
# SERVER_NAME=dustyshelf.com

# ==================== API KEY CONFIGURATION ====================

# API Key Settings
API_KEY_PREFIX=dsk_
API_KEY_LENGTH=32
API_KEY_HASH_ALGORITHM=sha256
HASH_API_KEYS=true

# ==================== REACT FRONTEND ====================

# Frontend Configuration
REACT_APP_BACKEND_URL=http://localhost:5000
REACT_APP_FRONTEND_URL=http://localhost:3000

# ==================== PAYMENT GATEWAY (Demo) ====================

# Payment Configuration (for demo purposes)
PAYMENT_GATEWAY=demo
# For production, integrate with actual gateway:
# PAYMENT_GATEWAY=stripe
# STRIPE_PUBLIC_KEY=pk_live_...
# STRIPE_SECRET_KEY=sk_live_...

# ==================== EMAIL CONFIGURATION ====================

# Email Service (optional, for notifications)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=noreply@dustyshelf.com

# ==================== LOGGING ====================

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=logs/dusty_shelf.log

# ==================== FEATURE FLAGS ====================

# Feature Flags
ENABLE_RECOMMENDATIONS=True
ENABLE_WISHLISTS=True
ENABLE_REVIEWS=True
ENABLE_DELIVERY_TRACKING=True

# ==================== PRODUCTION SETTINGS ====================

# Set to False in production
DEBUG=True

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ==================== NOTES ====================

# 1. For Google OAuth:
#    - Create a Google Cloud project
#    - Enable Google+ API
#    - Create OAuth 2.0 credentials
#    - Download as .json and extract values
#
# 2. For Google Books API:
#    - Enable Google Books API in Cloud Console
#    - Create an API key
#
# 3. For Database:
#    - SQLite (default, good for development)
#    - PostgreSQL (recommended for production)
#    - MySQL/MariaDB (alternative)
#
# 4. Keep .env in .gitignore
# 5. Never commit credentials to git
# 6. Change all default secrets before production deployment
