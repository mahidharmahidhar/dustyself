# ==================== DATABASE ====================
# SQLite (local development)
DATABASE_URL=sqlite:///dustyshelf.db

# ==================== FLASK CONFIGURATION ====================
# Secret key for Flask sessions
SECRET_KEY=dusty-shelf-secret-key-2024-change-in-production-update-this

# JWT secret key for token signing
JWT_SECRET=jwt-secret-key-2024-change-in-production-update-this

# Server configuration
SERVER_NAME=127.0.0.1:5000

# ==================== GOOGLE OAUTH 2.0 ====================
# Get these from Google Cloud Console: https://console.cloud.google.com/
# Steps:
# 1. Create a new project
# 2. Enable Google+ API
# 3. Create OAuth 2.0 credentials (Web Application)
# 4. Set redirect URIs:
#    - http://127.0.0.1:5000/login/google/authorized
#    - http://localhost:5000/login/google/authorized
# 5. Copy Client ID and Client Secret below

GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_DISCOVERY_URL=https://accounts.google.com/.well-known/openid-configuration

# ==================== APPLICATION SETTINGS ====================
# Environment
FLASK_ENV=development
FLASK_DEBUG=1

# Session settings
SESSION_TIMEOUT=3600
REMEMBER_ME_DURATION=2592000

# Payment Settings (Demo)
DEMO_PAYMENT_MODE=True

# Delivery & GPS Settings
STORE_LATITUDE=40.7128
STORE_LONGITUDE=-74.0060
DEFAULT_DELIVERY_COST=50
FREE_DELIVERY_THRESHOLD=1000

# API Rate Limiting
API_RATE_LIMIT=1000
API_RATE_LIMIT_WINDOW=3600

# ==================== GOOGLE BOOKS API ====================
GOOGLE_BOOKS_API_KEY=AIzaSyCrFYIUkq5ukUmuRdlV-Yu0gLcmtLjnn34

# ==================== API KEY CONFIGURATION ====================
# API key generation and security settings

# Hash API keys before storing in database (recommended for production)
HASH_API_KEYS=true

# Algorithm for hashing: sha256 or sha512
API_KEY_HASH_ALGORITHM=sha256

# Length of generated API key (without prefix)
API_KEY_LENGTH=32

# Prefix for API keys (e.g., dsk_ = Dusty Shelf Key)
API_KEY_PREFIX=dsk_

# Default rate limit for API keys (requests per hour)
API_KEY_DEFAULT_RATE_LIMIT=1000

# Optional: Enable API key expiry enforcement
API_KEY_ENABLE_EXPIRY=true

# Optional: Default expiry period in days (0 = no expiry)
API_KEY_DEFAULT_EXPIRY_DAYS=365